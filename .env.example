# Copy this file to backend/.env (never commit the real .env) and adjust values.
# The backend loads it automatically in local development; real environment
# variables always take precedence.

DB_URL=jdbc:postgresql://localhost:5433/todo_db
DB_USERNAME=todo_user
DB_PASSWORD=todo_password

# REQUIRED. HMAC signing secret for JWTs. Must be at least 32 characters.
# Generate a strong value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# Optional (defaults shown)
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
